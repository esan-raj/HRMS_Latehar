# Copy to .env and replace every placeholder. Never commit .env.

# At least 32 random characters. Used for the session cookie and CSRF tokens.
FLASK_SECRET_KEY=replace-with-a-long-random-string

# Runtime connection. Use the direct Postgres host, or the session pooler on port 5432.
# Do not use port 6543 (transaction pooler). Include sslmode=require.
# Session-pooler usernames look like hrms_app.PROJECT_REF. Direct usernames are hrms_app.
DATABASE_URL=postgresql://hrms_app:replace-me@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Direct connection used only by flask db. The postgres role, or another role that can create the hrms schema.
MIGRATION_DATABASE_URL=postgresql://postgres:replace-me@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Project URL with no trailing path, for example https://PROJECT_REF.supabase.co
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Publishable key (or the legacy anon key). Server-side only; it is not a service-role key.
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Supabase Auth user UUID of the single administrator. Not an email address.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# Leave blank when the project signs tokens with ES256 or RS256 (current Supabase projects).
# Set only for a legacy HS256 project if you intentionally verify with the shared secret.
# The recommended legacy check calls the Auth server and does not need this value.
SUPABASE_JWT_SECRET=

# Optional claim overrides. Defaults match Supabase Auth.
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1

# Set to 1 behind HTTPS. Keep 0 for local HTTP.
COOKIE_SECURE=0

# Set to 1 when a reverse proxy sets X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY=0

# SQLAlchemy pool on top of one persistent server. Keep this small.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
